# Cómo guarda los archivos el editor. No reformatea el código existente:
# solo evita CRLF, espacios al final de línea y archivos sin salto de línea final.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# En Markdown, dos espacios al final de una línea son un salto de línea.
trim_trailing_whitespace = false